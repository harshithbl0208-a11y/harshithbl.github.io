        "message": "=<div style=\"font-family: Arial, sans-serif; max-width:600px; margin:auto; border:1px solid #eee; padding:20px;\">\n\n  <!-- Logo -->\n  <div style=\"text-align:center; margin-bottom:20px;\">\n    <img src=\"https://drive.google.com/uc?export=view&id=1jsax-xoHIpnQLk87lX6dYvTe9kPrRai4\" alt=\"Certisured Logo\" style=\"max-width:150px;\">\n  </div>\n\n  <!-- Title -->\n  <h2 style=\"color:#2c3e50; text-align:center;\">Enrollment Confirmation</h2>\n\n  <!-- Body -->\n  <p>Dear {{ $('Code in JavaScript').item.json.name }},</p>\n\n  <p>\n  We are pleased to inform you that your enrollment with <b>Certisured</b> has been successfully completed.\n  </p>\n\n  <hr>\n\n  <!-- Details -->\n  <p><b>Student ID:</b> {{ $('Code in JavaScript').item.json.student_id }}</p>\n  <p><b>Course:</b> {{ $('Code in JavaScript').item.json.course }}</p>\n  <p><b>Payment Mode:</b> {{ $('Code in JavaScript').item.json.fee_mode }}</p>\n  <p><b>EMI per month:</b> {{ $('Code in JavaScript').item.json.emi_per_month }}</p>\n\n  <hr>\n\n  <!-- Attachment Note -->\n  <p>\n  📄 Your official enrollment document is attached with this email.\n  </p>\n\n  <!-- Footer -->\n  <p>\n  Warm regards,<br><br>\n  <b>Team Certisured</b><br>\n  </p>\n\n  <hr>\n\n  <p style=\"font-size:12px; color:gray; text-align:center;\">\n  Certisured | Bangalore<br>\n  📧 hello@certisured.com | 📞 +91 96066 98866\n  </p>\n\n</div>",
