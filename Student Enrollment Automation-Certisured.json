      "id": "baf91bc7-5fa3-4909-8300-b46edba1adcd",
      "name": "On form submission",
      "webhookId": "3c25aff0-2975-4e6a-a222-65e2a3e7dbae"
    },
    {
      "parameters": {
        "jsCode": "// Get form submission directly from the Onform node\nconst formItems = $(\"On form submission\").all();\nconst formItem = formItems[0] || { json: {}, binary: {} };\nconst formData = formItem.json || {};\nconst binaryData = formItem.binary || {};\n\n// Get all existing rows from Google Sheets node\nconst sheetItems = $(\"Get row(s) in sheet\").all();\n\nconst currentYear = new Date().getFullYear();\nlet maxNumber = 0;\n\n// Find highest student_id for current year\nfor (const item of sheetItems) {\n  const json = item.json || {};\n\n  if (!json.student_id) continue;\n\n  const id = String(json.student_id).trim();\n  const match = id.match(/^CT(\\d{4})(\\d+)$/);\n\n  if (match) {\n    const idYear = Number(match[1]);\n    const idNumber = Number(match[2]);\n\n    if (idYear === currentYear && idNumber > maxNumber) {\n      maxNumber = idNumber;\n    }\n  }\n}\n\n// Generate next student ID\nconst nextNumber = maxNumber + 1;\nconst student_id = `CT${currentYear}${String(nextNumber).padStart(3, \"0\")}`;\n\n// EMI logic\nconst fee = Number(formData.fee || 0);\nconst mode = formData.fee_mode?.value || formData.fee_mode || \"Full payment\";\nconst months = Number(formData.emi_months || 0);\n\nlet emi_per_month = \"\";\nlet total_months = \"\";\nlet installment_details = \"\";\n\nif (mode === \"EMI\" && months > 0) {\n  emi_per_month = (fee / months).toFixed(2);\n  total_months = months;\n\n  const today = new Date();\n  const details = [];\n\n  for (let i = 0; i < months; i++) {\n    const d = new Date(\n      today.getFullYear(),\n      today.getMonth() + i,\n      today.getDate()\n    );\n\n    const date = d.toLocaleDateString(\"en-GB\");\n    details.push(`${i + 1}. ${date} : ${emi_per_month}`);\n  }\n\n  installment_details = details.join(\"\\n\");\n} else {\n  emi_per_month = \"Full Payment\";\n  total_months = 0;\n  installment_details = \"Full payment completed\";\n}\n\n// Return single final item\nreturn [\n  {\n    json: {\n      student_id,\n      ...formData,\n      emi_per_month,\n      total_months,\n      installment_details\n    },\n    binary: binaryData\n  }\n];"
      },
