    {
      "parameters": {
        "jsCode": "// n8n Code Node\n// Clean ATS Extraction\n\nconst results = items.map(item => {\n\n    const text = item.json.output || item.json.text || \"\";\n\n    // Safe Extract Function\n    const extractValue = (regex) => {\n        const match = text.match(regex);\n        return match ? match[1].trim() : \"Not Mentioned\";\n    };\n\n    // Extract Fields\n    const candidate_name = extractValue(/Candidate Name:\\s*(.*)/i);\n\n    const current_role = extractValue(/Current Role:\\s*(.*)/i);\n\n    const experience = extractValue(/Years of Experience:\\s*(.*)/i);\n\n    const ats_score = parseInt(\n        extractValue(/ATS Match Score:\\s*(\\d+)/i)\n    ) || 0;\n\n    const match_percentage = extractValue(\n        /Match Percentage:\\s*(.*)/i\n    );\n\n    const eligibility_status = extractValue(\n        /Eligibility Status:\\s*(.*)/i\n    );\n\n    const final_recommendation = extractValue(\n        /Final HR Recommendation:\\s*(.*)/i\n    );\n\n    // Fixed Summary Extraction\n    const summaryMatch = text.match(\n        /Short Final Summary:\\s*([\\s\\S]*?)$/i\n    );\n\n    const summary = summaryMatch\n        ? summaryMatch[1].trim()\n        : \"Not Mentioned\";\n\n    // Normalize Score\n    let normalized_score = ats_score;\n\n    if (normalized_score > 100) {\n        normalized_score = 100;\n    }\n\n    // Category Logic\n    let shortlist_category = \"\";\n\n    if (normalized_score >= 90) {\n        shortlist_category = \"Excellent Match\";\n    }\n    else if (normalized_score >= 75) {\n        shortlist_category = \"Strong Match\";\n    }\n    else if (normalized_score >= 60) {\n        shortlist_category = \"Moderate Match\";\n    }\n    else {\n        shortlist_category = \"Weak Match\";\n    }\n\n    // Final Output\n    return {\n        json: {\n            candidate_name,\n            current_role,\n            experience,\n            ats_score: normalized_score,\n            match_percentage,\n            eligibility_status,\n            final_recommendation,\n            shortlist_category,\n            summary\n        }\n    };\n\n});\n\nreturn results;"
      },
